+/// The working PC port observes Mario's lower-screen UI before renderer-specific
+/// transforms. On iOS, Vulkan can otherwise send these tiny draws through the
+/// raw host-shader path, which bypasses `mario_course_ui_draw` entirely. Keep
+/// only this narrow class of draws on the decoded path so the existing strict
+/// classifier gets the native shaded vertices.
+fn mario_course_ui_candidate(registers: &[u32], vertex_count: u32) -> bool {
+    (3..=48).contains(&vertex_count)
+        && registers[REG_BLEND_FUNC] == 0x7676_0000
+        && (read_float24(registers, REG_VIEWPORT_WIDTH) - 120.0).abs() < 0.5
+        && (read_float24(registers, REG_VIEWPORT_HEIGHT) - 160.0).abs() < 0.5
+}
