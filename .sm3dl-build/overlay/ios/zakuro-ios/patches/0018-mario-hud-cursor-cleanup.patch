index e81d35f..84ba515 100644
--- a/crates/zakuro-gpu/shaders/present.frag
+++ b/crates/zakuro-gpu/shaders/present.frag
@@ -81,24 +81,32 @@ void main() {
 #else
     vec3 rgb = shown(screen, crop.area, crop.bounds);
     if (crop.mode == 3) {
-        // Mario 3D Land course medal: each medal is presented from its own
-        // square source instead of the original rectangular status strip. A
-        // soft circular cut keeps only the icon and never exposes strip edges.
-        float radius = length(uv * 2.0 - 1.0);
-        float alpha = 1.0 - smoothstep(0.88, 1.0, radius);
+        // Keep Nintendo's actual medal pixels, but remove the lower-screen green
+        // backing before the icon is composited into the black phone pillar.
+        float green_backing = step(0.30, rgb.g)
+            * step(rgb.r * 1.10, rgb.g)
+            * step(rgb.b * 1.05, rgb.g);
+        float alpha = 1.0 - green_backing;
         colour = vec4(rgb * alpha, alpha);
     } else if (crop.mode == 4) {
-        // The reserve item is a live 3D model. The source crop is deliberately
-        // inside the original white/yellow touch-slot ring; remove the remaining
-        // pale slot interior and keep the model itself. This operates on the
-        // already high-resolution lower-screen GPU image, not a CPU/upscaled
-        // screenshot.
+        // The reserve item is a live 3D model. Keep the proven native crop/key
+        // that preserves Mario's real white face/eyes and removes only the slot.
         float radius = length(uv * 2.0 - 1.0);
         vec3 slot = vec3(0.58, 0.69, 0.72);
         float slot_distance = length(rgb - slot);
         float alpha = smoothstep(0.105, 0.235, slot_distance)
             * (1.0 - smoothstep(0.90, 1.0, radius));
         colour = vec4(rgb * alpha, alpha);
+    } else if (crop.mode == 5) {
+        // Host controller cursor for the real lower touchscreen: black outer
+        // edge plus a white inner band so it remains visible over any menu art.
+        float radius = length(uv * 2.0 - 1.0);
+        float outer = 1.0 - smoothstep(0.92, 1.0, radius);
+        float hole = 1.0 - smoothstep(0.50, 0.60, radius);
+        float ring = outer * (1.0 - hole);
+        float white_band = smoothstep(0.62, 0.68, radius)
+            * (1.0 - smoothstep(0.80, 0.86, radius));
+        colour = vec4(vec3(white_band) * ring, ring);
     } else {
         colour = vec4(rgb, 1.0);
     }
