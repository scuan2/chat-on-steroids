 // on that lower-screen draw being recognized in the same frame.
-const MARIO_HUD_ALL: u32 = MARIO_HUD_LIVES | MARIO_HUD_MEDALS | MARIO_HUD_LEVEL;
+const MARIO_HUD_RECENT_FRAMES: u8 = 8;
 
 #[derive(Default)]
 struct MarioCourseUiDraw {
@@ -1930,6 +1930,8 @@ pub struct Resources {
     pub(crate) hardware: Option<hardware::Hardware>,
     /// Course-HUD draw signatures seen since the last title frame completed.
     mario_hud_parts: u32,
