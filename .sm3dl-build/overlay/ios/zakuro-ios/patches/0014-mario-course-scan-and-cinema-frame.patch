+/// Super Mario 3D Land's cutscenes draw two 400x20 black matte quads over the
+/// already-widened top screen.  The PC port identifies and omits exactly this
+/// draw in 16:9; do the same here instead of stretching the matte into the host
+/// margins and leaving visible seams.
+fn mario_cinema_frame(
+    shaded: &[Vertex],
+    target: &ColorTarget,
+    textures: &[Option<BoundTexture>; 3],
+    registers: &[u32],
+    wide_margin: u32,
+) -> bool {
+    if wide_margin == 0
+        || shaded.len() != 12
+        || target.buffer_width != 240
+        || target.buffer_height != 400
+        || registers[REG_DEPTH_COLOR_MASK] != 0x1f00
+        || registers[REG_STENCIL_TEST] & 1 != 0
+        || registers[REG_COLOR_OPERATION] & (1 << 8) == 0
+        || registers[REG_BLEND_FUNC] != 0x76760000
+    {
+        return false;
+    }
+    let Some(texture) = textures[0].as_ref() else {
+        return false;
+    };
+    if texture.width != 8
+        || texture.height != 8
+        || texture.texels.len() < 64
+        || !texture.texels.iter().take(64).all(|&pixel| pixel == [255; 4])
+    {
+        return false;
+    }
+
+    // The top LCD is rotated in PICA clip space.  Each matte is a six-vertex
+    // quad spanning the full screen width and exactly 20 pixels in from one
+    // horizontal edge.
+    const INNER: f32 = 1.0 - 2.0 * 20.0 / 240.0;
+    let near = |a: f32, b: f32| (a - b).abs() < 0.0005;
+    let w = shaded[0].clip[3];
+    if !(w > 0.0) {
+        return false;
+    }
+    let mut corners = [0u32; 2];
+    let mut sides = [false; 2];
+    for quad in 0..2 {
+        let first = quad * 6;
+        let positive = shaded[first].clip[0] > 0.0;
+        sides[quad] = positive;
+        for vertex in &shaded[first..first + 6] {
+            let [x, y, z, vw] = vertex.clip;
+            if !near(vw, w) || !near(z / vw, -0.5) || ((x > 0.0) != positive) {
+                return false;
+            }
+            let x = (x / vw).abs();
+            let y = y / vw;
+            let outer = near(x, 1.0);
+            if (!outer && !near(x, INNER)) || !near(y.abs(), 1.0) {
+                return false;
+            }
+            corners[quad] |= 1 << ((if outer { 2 } else { 0 }) + if y > 0.0 { 1 } else { 0 });
+        }
+    }
+    sides[0] != sides[1] && corners == [15, 15]
+}
