+/// Replays one of Mario's native HUD draws into a transparent software target.
+/// The title's texture environment, alpha test and textures are reused verbatim;
+/// only the output blend changes to premultiplied source-over.
+fn capture_mario_ui_draw(
+    registers: &[u32],
+    state: &DrawState,
+    placed: &[Screen],
+    indices: &[u32],
+    surface: &mut Option<Surface>,
+    bounds: &mut Option<[i32; 4]>,
+) {
+    const WIDTH: u32 = 240;
+    const HEIGHT: u32 = 400;
+    if state.target.buffer_width != WIDTH || state.target.buffer_height != HEIGHT || indices.len() < 3 {
+        return;
+    }
+
+    if surface.as_ref().is_none_or(|s| s.data.len() != (WIDTH * HEIGHT * 4) as usize) {
+        *surface = Some(Surface {
+            base: 0,
+            bytes: 4,
+            first: 0,
+            data: vec![0; (WIDTH * HEIGHT * 4) as usize],
+        });
+    }
+
+    let mut overlay_registers = registers.to_vec();
+    // RGB: src-alpha / one-minus-src-alpha. Alpha: one /
+    // one-minus-src-alpha. This produces premultiplied RGBA over transparent.
+    overlay_registers[REG_BLEND_FUNC] = 0x7176_0000;
+    let overlay_state = DrawState {
+        target: ColorTarget {
+            addr: 0,
+            left: state.target.left,
+            bottom: state.target.bottom,
+            right: state.target.right,
+            top: state.target.top,
+            buffer_width: WIDTH,
+            buffer_height: HEIGHT,
+            format: ColorFormat::Rgba8,
+            write: [true; 4],
+        },
+        depth_map: state.depth_map,
+        depth_stencil: None,
+        tex_env: state.tex_env,
+        alpha_test: state.alpha_test,
+        blend: crate::blend::Blend::read(&overlay_registers),
+        logic_op: None,
+        textures: state.textures,
+        texture2_uses_coord1: state.texture2_uses_coord1,
+        texture0_projected: state.texture0_projected,
+        lighting: state.lighting,
+        tables: state.tables,
+        proctex: state.proctex,
+        proctex_tables: state.proctex_tables,
+        fog: None,
+        fog_table: state.fog_table,
+    };
+
+    let triangles: Vec<[Screen; 3]> = indices
+        .chunks_exact(3)
+        .filter_map(|index| {
+            let a = *index.first()? as usize;
+            let b = *index.get(1)? as usize;
+            let c = *index.get(2)? as usize;
+            Some([*placed.get(a)?, *placed.get(b)?, *placed.get(c)?])
+        })
+        .collect();
+    if triangles.is_empty() {
+        return;
+    }
+
+    let mut stats = FillStats::default();
+    let mut no_depth = None;
+    fill(
+        surface,
+        &mut no_depth,
+        &triangles,
+        overlay_state.target.bottom..overlay_state.target.top,
+        &overlay_state,
+        &mut stats,
+    );
+
+    let mut left = WIDTH as i32;
+    let mut bottom = HEIGHT as i32;
+    let mut right = 0i32;
+    let mut top = 0i32;
+    for &index in indices {
+        let Some(vertex) = placed.get(index as usize) else { continue };
+        left = left.min(vertex.x.floor() as i32);
+        right = right.max(vertex.x.ceil() as i32);
+        bottom = bottom.min(vertex.y.floor() as i32);
+        top = top.max(vertex.y.ceil() as i32);
+    }
+    left = (left - 1).clamp(0, WIDTH as i32);
+    right = (right + 1).clamp(0, WIDTH as i32);
+    bottom = (bottom - 1).clamp(0, HEIGHT as i32);
+    top = (top + 1).clamp(0, HEIGHT as i32);
+    if left >= right || bottom >= top {
+        return;
+    }
+    match bounds {
+        Some(found) => {
+            found[0] = found[0].min(left);
+            found[1] = found[1].min(bottom);
+            found[2] = found[2].max(right);
+            found[3] = found[3].max(top);
+        }
+        None => *bounds = Some([left, bottom, right, top]),
+    }
+}
+
+/// Crops a rotated lower-screen replay and turns it upright. In the native
+/// 240x400 render target, lower-screen X runs opposite window Y and lower-screen
+/// Y runs opposite window X.
+fn upright_mario_image(surface: &Surface, [left, bottom, right, top]: [i32; 4]) -> (Vec<u8>, [u32; 2]) {
+    if left >= right || bottom >= top {
+        return (Vec::new(), [0, 0]);
+    }
+    let source_width = (right - left) as u32;
+    let source_height = (top - bottom) as u32;
+    let (width, height) = (source_height, source_width);
+    let mut pixels = vec![0u8; (width * height * 4) as usize];
+    for y in 0..height {
+        for x in 0..width {
+            let sx = (right - 1 - y as i32) as u32;
+            let sy = (top - 1 - x as i32) as u32;
+            let row = 400 - 1 - sy;
+            let index = crate::format::morton_offset(sx, row, 240, 1);
+            let offset = (index * 4 - surface.first) as usize;
+            if offset + 4 > surface.data.len() {
+                continue;
+            }
+            let rgba = ColorFormat::Rgba8.decode(&surface.data[offset..offset + 4]);
+            let out = ((y * width + x) * 4) as usize;
+            pixels[out..out + 4].copy_from_slice(&rgba);
+        }
+    }
+    (pixels, [width, height])
+}
+
+/// Removes the native green status backing, then separates the three original
+/// medal draws and stacks them upright in their original left-to-right order.
+fn upright_mario_medals(surface: &Surface, bounds: [i32; 4]) -> (Vec<u8>, [u32; 2]) {
+    let (mut strip, [width, height]) = upright_mario_image(surface, bounds);
+    if width < height * 2 || width < 3 {
+        return (strip, [width, height]);
+    }
+
+    for pixel in strip.chunks_exact_mut(4) {
+        let [r, g, b] = [pixel[0] as u32, pixel[1] as u32, pixel[2] as u32];
+        if g >= 87 && g * 100 > r * 114 && g * 100 > b * 108 {
+            pixel.fill(0);
+        }
+    }
+
+    let mut medals = Vec::with_capacity(3);
+    for medal in 0..3 {
+        let x0 = medal * width / 3;
+        let x1 = (medal + 1) * width / 3;
+        let segment_width = x1 - x0;
+        let mut left = segment_width;
+        let mut top = height;
+        let mut right = 0;
+        let mut bottom = 0;
+        for y in 0..height {
+            for x in 0..segment_width {
+                let alpha = strip[((y * width + x0 + x) * 4 + 3) as usize];
+                if alpha != 0 {
+                    left = left.min(x);
+                    top = top.min(y);
+                    right = right.max(x + 1);
+                    bottom = bottom.max(y + 1);
+                }
+            }
+        }
+        if left >= right || top >= bottom {
+            continue;
+        }
+        left = left.saturating_sub(1);
+        top = top.saturating_sub(1);
+        right = (right + 1).min(segment_width);
+        bottom = (bottom + 1).min(height);
+        let crop_width = right - left;
+        let crop_height = bottom - top;
+        let mut pixels = vec![0; (crop_width * crop_height * 4) as usize];
+        for y in 0..crop_height {
+            let source = ((top + y) * width + x0 + left) as usize * 4;
+            let target = (y * crop_width) as usize * 4;
+            pixels[target..target + crop_width as usize * 4]
+                .copy_from_slice(&strip[source..source + crop_width as usize * 4]);
+        }
+        medals.push((pixels, crop_width, crop_height));
+    }
+    if medals.len() != 3 {
+        return (strip, [width, height]);
+    }
+
+    const GAP: u32 = 4;
+    let output_width = medals.iter().map(|(_, w, _)| *w).max().unwrap_or(0);
+    let output_height = medals.iter().map(|(_, _, h)| *h).sum::<u32>() + GAP * 2;
+    let mut output = vec![0; (output_width * output_height * 4) as usize];
+    let mut y_offset = 0;
+    for (pixels, medal_width, medal_height) in medals {
+        let x_offset = (output_width - medal_width) / 2;
+        for y in 0..medal_height {
+            let source = (y * medal_width * 4) as usize;
+            let target = ((y_offset + y) * output_width + x_offset) as usize * 4;
+            output[target..target + medal_width as usize * 4]
+                .copy_from_slice(&pixels[source..source + medal_width as usize * 4]);
+        }
+        y_offset += medal_height + GAP;
+    }
+    (output, [output_width, output_height])
+}
