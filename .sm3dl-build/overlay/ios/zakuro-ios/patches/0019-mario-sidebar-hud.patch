diff --git a/crates/zakuro-core/src/lib.rs b/crates/zakuro-core/src/lib.rs
index 0308042..ef35f31 100644
--- a/crates/zakuro-core/src/lib.rs
+++ b/crates/zakuro-core/src/lib.rs
@@ -1233,10 +1233,9 @@ impl System {
         self.gpu.mario_pause_active()
     }

-    /// The last completed Mario course frame's native Star Medal strip,
-    /// replayed to transparent premultiplied RGBA for the host presentation.
-    pub fn mario_medal_image(&self) -> Option<(&[u8], [u32; 2], u64)> {
-        self.gpu.mario_medal_image()
+    /// The three native Star Medal identities in display order.
+    pub fn mario_medal_state(&self) -> [u8; 3] {
+        self.gpu.mario_medal_state()
     }

     /// the top screen's right eye picture on the host GPU, like gpu_screen gives the left, when the title draws in 3D
diff --git a/crates/zakuro-gpu/shaders/present.frag b/crates/zakuro-gpu/shaders/present.frag
index 97c3d16..9c2668b 100644
--- a/crates/zakuro-gpu/shaders/present.frag
+++ b/crates/zakuro-gpu/shaders/present.frag
@@ -60,6 +60,50 @@ vec3 shown(sampler2D image, vec4 area, vec4 bounds) {
     return sum / float(taps.x * taps.y);
 }

+#ifndef STEREO
+// Analytic edges stay sharp at any host resolution. Match the original
+// octagonal gold medal, pale inset, and five-point star with two eyes.
+float coverage(float d) {
+    float aa = max(fwidth(d), 0.001);
+    return 1.0 - smoothstep(-aa * 0.5, aa * 0.5, d);
+}
+vec4 medal(bool collected, bool identified) {
+    vec2 p = (uv - 0.5) * 2.0;
+    float r = length(p);
+    if (!collected) {
+        float a = atan(p.y, p.x);
+        float arc = abs(fract(a * (8.0 / 6.28318530718) + 0.5) - 0.5);
+        float dash = coverage(arc - 0.33);
+        float alpha = coverage(abs(r - 0.74) - 0.075) * dash;
+        // The native empty glyph is black and disappears on a black pillar.
+        // A neutral light outline preserves its dashed shape and legibility.
+        vec3 gray = identified ? vec3(0.62, 0.65, 0.70) : vec3(0.36, 0.38, 0.42);
+        return vec4(gray * alpha, alpha);
+    }
+    vec2 q = abs(p);
+    float oct = max(max(q.x, q.y), (q.x + q.y) * 0.70710678);
+    float alpha = coverage(oct - 0.91);
+    vec3 c = vec3(0.27, 0.16, 0.025);
+    c = mix(c, vec3(1.0, 0.86, 0.23), coverage(oct - 0.855));
+    vec3 gold = mix(vec3(1.0, 0.94, 0.42), vec3(0.93, 0.56, 0.055), clamp(uv.y, 0.0, 1.0));
+    c = mix(c, gold, coverage(oct - 0.79));
+    c = mix(c, vec3(0.70, 0.40, 0.055), coverage(r - 0.635));
+    c = mix(c, mix(vec3(1.0, 0.98, 0.79), vec3(1.0, 0.84, 0.37), uv.y), coverage(r - 0.585));
+    float a = atan(p.y, p.x) + 1.57079632679 + 6.28318530718;
+    float step_angle = 0.62831853072;
+    float sector = floor(a / step_angle);
+    float t = mod(a, step_angle);
+    float r0 = mod(sector, 2.0) < 1.0 ? 0.45 : 0.215;
+    float r1 = mod(sector, 2.0) < 1.0 ? 0.215 : 0.45;
+    float edge = r0 * r1 * sin(step_angle) / (r1 * sin(step_angle - t) + r0 * sin(t));
+    c = mix(c, vec3(0.77, 0.45, 0.045), coverage(r - edge - 0.025));
+    c = mix(c, vec3(1.0, 0.73, 0.09), coverage(r - edge + 0.012));
+    float eye = length(vec2((abs(p.x) - 0.079) / 0.028, (p.y + 0.033) / 0.064));
+    c = mix(c, vec3(0.25, 0.16, 0.04), coverage(eye - 1.0));
+    return vec4(c * alpha, alpha);
+}
+#endif
+
 void main() {
 #ifdef STEREO
     vec3 left = shown(screen, crop.area, crop.bounds);
@@ -79,24 +123,36 @@ void main() {
         colour = vec4((int(gl_FragCoord.y) & 1) == 0 ? left : right, 1.0);
     }
 #else
-    vec3 rgb = shown(screen, crop.area, crop.bounds);
-    if (crop.mode == 3) {
-        // Mario 3D Land course medals: the original lower-screen status strip
-        // is green behind the three medal sprites. Remove only that backing;
-        // yellow/black/white medal pixels stay untouched.
-        float green_backing = step(0.34, rgb.g)
-            * step(rgb.r * 1.14, rgb.g)
-            * step(rgb.b * 1.08, rgb.g);
-        float alpha = 1.0 - green_backing;
-        colour = vec4(rgb * alpha, alpha);
-    } else if (crop.mode == 4) {
-        // The reserve item is a live 3D model inside a circular slot. Keep the
-        // native circle and fade only its square crop's corners.
-        float radius = length(uv * 2.0 - 1.0);
-        float alpha = 1.0 - smoothstep(0.96, 1.0, radius);
-        colour = vec4(rgb * alpha, alpha);
+    if (crop.mode >= 5) {
+        bool collected = crop.mode == 5;
+        bool identified = crop.mode != 7;
+        if (!identified) {
+            // Read the same native glyph on the completed lower LCD when
+            // the draw did not expose its original atlas cell. A gold
+            // interior and a dark dashed outline are the two retail states.
+            int gold = 0;
+            int dark = 0;
+            for (int y = 0; y < 5; ++y) {
+                for (int x = 0; x < 5; ++x) {
+                    vec2 at = crop.area.xy + crop.area.zw * ((vec2(x,y) + 0.5) / 5.0);
+                    vec3 s = texture(screen, clamp(at, crop.bounds.xy, crop.bounds.zw)).rgb;
+                    if (s.r > 0.55 && s.g > 0.32 && s.r > s.g * 0.92 && s.b < s.g * 0.65) ++gold;
+                    if (max(max(s.r,s.g),s.b) < 0.20) ++dark;
+                }
+            }
+            collected = gold >= 3;
+            identified = collected || dark >= 2;
+        }
+        colour = medal(collected, identified);
     } else {
-        colour = vec4(rgb, 1.0);
+        vec3 rgb = shown(screen, crop.area, crop.bounds);
+        if (crop.mode == 4) {
+            // The full 153.6px frame, not an arbitrary cut through the item.
+            float alpha = coverage(length(uv * 2.0 - 1.0) - (153.6 / 156.0));
+            colour = vec4(rgb * alpha, alpha);
+        } else {
+            colour = vec4(rgb, 1.0);
+        }
     }
 #endif
 }
