 impl VulkanPresenter {
     pub fn set_mario_course_hud(&mut self, enabled: bool) {
         self.mario_course_hud = enabled;
+        if enabled {
+            self.mario_touch_overlay = false;
+        }
     }
 
     pub fn set_mario_pause_overlay(&mut self, enabled: bool) {
         self.mario_pause_overlay = enabled;
+        if enabled {
+            self.mario_touch_overlay = false;
+        }
+    }
+
+    fn mario_modal_viewport(&self) -> Option<Viewport> {
+        if self.arrangement != ScreenLayout::TopOnly || self.orientation != ScreenOrientation::North {
+            return None;
+        }
+        let game = super::layout(
+            self.extent.width,
+            self.extent.height,
+            ScreenLayout::TopOnly,
+            ScreenOrientation::North,
+            self.top_width,
+            false,
+        )
+        .0?;
+        let height = game.height * 0.70;
+        let width = height * (4.0 / 3.0);
+        Some(Viewport {
+            x: game.x + (game.width - width) * 0.5,
+            y: game.y + (game.height - height) * 0.5,
+            width,
+            height,
+        })
+    }
+
+    pub fn toggle_mario_touch_overlay(&mut self) -> bool {
+        if self.mario_course_hud || self.mario_pause_overlay {
+            self.mario_touch_overlay = false;
+            return false;
+        }
+        self.mario_touch_overlay = !self.mario_touch_overlay;
+        self.mario_touch_overlay
+    }
+
+    pub fn mario_touch_overlay_visible(&self) -> bool {
+        self.mario_touch_overlay && !self.mario_course_hud && !self.mario_pause_overlay
+    }
+
+    pub fn mario_touch_viewport(&self) -> Option<Viewport> {
+        self.mario_touch_overlay_visible().then(|| self.mario_modal_viewport()).flatten()
+    }
+
+    pub fn mario_touch_map(&self, x: f32, y: f32) -> Option<(u16, u16)> {
+        if !x.is_finite() || !y.is_finite() {
+            return None;
+        }
+        let viewport = self.mario_touch_viewport()?;
+        let px = x.clamp(0.0, 1.0) * self.extent.width as f32;
+        let py = y.clamp(0.0, 1.0) * self.extent.height as f32;
+        if px < viewport.x
+            || py < viewport.y
+            || px >= viewport.x + viewport.width
+            || py >= viewport.y + viewport.height
+        {
+            return None;
+        }
+        let u = (px - viewport.x) / viewport.width;
+        let v = (py - viewport.y) / viewport.height;
+        Some((
+            (u * 319.0).round().clamp(0.0, 319.0) as u16,
+            (v * 239.0).round().clamp(0.0, 239.0) as u16,
+        ))
     }
 }
 
