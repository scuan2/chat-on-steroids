+    // sprites. This only keeps an already-active pause overlay alive; by itself
+    // it is not enough to enter pause mode.
+    if texture.width == 16
+        && texture.height == 16
+        && shaded.len() == 24
+        && left <= 4.0
+        && right >= 316.0
