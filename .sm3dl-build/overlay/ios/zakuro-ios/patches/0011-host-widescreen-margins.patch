+/// The presenter later samples only the reserve item and Star Medals from the
+/// completed lower screen, so no CPU readback or duplicated UI is needed.
+fn mario_course_ui_draw(
+    shaded: &[Vertex],
+    target: &ColorTarget,
+    textures: &[Option<BoundTexture>; 3],
