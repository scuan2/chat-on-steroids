+        if left >= 0.0 && right <= 105.0 && texture.width == 128 && texture.height == 128 {
+            return MarioCourseUiDraw { hud_part: MARIO_HUD_LEVEL, ..Default::default() };
+        }
+        if left >= 211.0 && right <= 320.0 && texture.width == 32 && texture.height == 256 {
+            return MarioCourseUiDraw { hud_part: MARIO_HUD_LIVES, ..Default::default() };
+        }
+        if left >= 105.0 && right <= 213.0 && bottom - top >= 19.0 {
+            return MarioCourseUiDraw { hud_part: MARIO_HUD_MEDALS, ..Default::default() };
+        }
+    }
+    if texture.width == 128
+        && texture.height == 128
+        && left >= 105.0
+        && right <= 215.0
+        && top >= 110.0
+        && bottom <= 144.0
+    {
+        return MarioCourseUiDraw { hud_part: MARIO_HUD_RESERVE, ..Default::default() };
+    }
+    if left >= 78.0 && right <= 242.0 && top >= 49.0 && bottom <= 215.0 {
+        return MarioCourseUiDraw { hud_part: MARIO_HUD_RESERVE, ..Default::default() };
+    }
+    MarioCourseUiDraw::default()
